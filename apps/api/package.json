{
  "name": "@tss/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/dev-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.10",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@tss/shared": "0.1.0",
    "@vercel/functions": "^3.10.1",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
