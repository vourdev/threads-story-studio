{
  "name": "threads-story-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tss/api",
    "start:api": "npm run start -w @tss/api",
    "worker": "npm run worker -w @tss/api",
    "db:generate": "npm run db:generate -w @tss/api",
    "db:migrate": "npm run db:migrate -w @tss/api",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
