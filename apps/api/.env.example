# ─── Core (required) ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Postgres. Local: postgres://localhost:5432/threads_story_studio · Vercel: Neon *pooled* connection string
DATABASE_URL=postgres://localhost:5432/threads_story_studio
DATABASE_POOL_MAX=5
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# 32 bytes, base64 — encrypts stored Threads tokens. openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Public URL of this API (OAuth callback + tracked /r/ links). Must be https in production.
API_BASE_URL=http://localhost:3000
# Must match "scheme" in apps/mobile/app.json
APP_SCHEME=threadsstory
# Sign-up is open only while there are zero users. Set true to allow more accounts.
ALLOW_SIGNUP=false
# Salt for hashing visitor IPs on tracked clicks (openssl rand -hex 16)
CLICK_IP_SALT=

# ─── Daily maintenance ─────────────────────────────────────────────
# Vercel Cron (daily) sends "Authorization: Bearer $CRON_SECRET" to /api/cron/tick. openssl rand -hex 24
CRON_SECRET=

# ─── AI providers (at least one) ────────────────────────────────────
# Default order when a task has no explicit provider in Settings
AI_PROVIDER_PRIORITY=omniroute,gemini
# OmniRoute (OpenAI-compatible). Base URL may be the host root, /v1 or /v1/chat/completions.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
# Combo name or provider/model id, e.g. vour-combos
OMNIROUTE_MODEL=
OMNIROUTE_MODEL_FAST=
OMNIROUTE_MAX_CONCURRENT=1
OMNIROUTE_MIN_INTERVAL_MS=1000
# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096

# ─── Threads (direct publishing, optional) ─────────────────────────
# Meta app with the Threads use case. Add this redirect URI in the app settings:
#   ${API_BASE_URL}/api/threads/oauth/callback   (must be https)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# Also request threads_manage_insights (official engagement metrics)
THREADS_REQUEST_INSIGHTS=false

# ─── Buffer (optional) ──────────────────────────────────────────────
# Personal API key from https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# ─── Shopee Affiliate Open API (optional) ──────────────────────────
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.co.id/graphql

# ─── Push (optional) ────────────────────────────────────────────────
# Only needed if "Enhanced push security" is enabled for your Expo project
EXPO_ACCESS_TOKEN=
